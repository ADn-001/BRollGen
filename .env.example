# Openverse API credentials for the B-Roll Engine Openverse adapters
# (Wikimedia Commons :3002, NASA :3003, All Openverse :3005).
#
# One-time free registration — returns client_id + client_secret:
#   POST https://api.openverse.org/v1/auth_tokens/register/
#   Body: {"name": "BRollGen V1", "description": "...", "email": "you@example.com"}
#
# Setup:
#   1. Copy this file to .env         (cp .env.example .env)
#   2. Paste your real client_id / client_secret below
#   3. Restart the adapters (start_adapters.bat) — they read .env on startup
#
# .env is gitignored; never commit real secrets. Without credentials the
# adapters still work anonymously (20 results/request max).
#
# Precedence: if you ALSO set "Auth Token" on a source in the Sources UI
# (as client_id:client_secret), that header value wins over these env vars.

OPENVERSE_CLIENT_ID=your_client_id_here
OPENVERSE_CLIENT_SECRET=your_client_secret_here
